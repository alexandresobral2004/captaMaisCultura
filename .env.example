# Copie para .env.local e preencha. Nunca versione o .env.local.

# --- Obrigatórias em produção ---
# Assina o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=
# Token dos scripts/cron externos (enviado no header X-Scan-Token)
SCAN_TOKEN=
# URL pública do sistema, sem barra no final
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- IA ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FULL=
# Jev (TypeSafe), triagem por eixo. Use um dos dois nomes
TYPESAFE_API_KEY=
JEV_API_KEY=
JEV_MODEL=
JEV_CONFIANCA_MINIMA=

# --- Opcionais ---
DATABASE_PATH=
TAVILY_API_KEY=
LLAMA_CLOUD_API_KEY=
PROSAS_EMAIL=
PROSAS_PASSWORD=

# Só desenvolvimento: preenche o login automaticamente (use em .env.local, nunca em produção)
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=
# NEXT_PUBLIC_DEV_LOGIN_SENHA=
