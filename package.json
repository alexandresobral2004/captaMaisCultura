{
  "name": "capta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:watch": "nodemon",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "DATABASE_URL=postgres://capta:capta@localhost:5433/captadb vitest run --no-file-parallelism",
    "db:up": "docker compose up -d postgres && docker compose exec postgres sh -c 'until pg_isready -U capta; do sleep 1; done'",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrar-dados": "tsx scripts/migrar-dados-sqlite-para-pg.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@llamaindex/llama-cloud": "^2.4.1",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.0.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^0.294.0",
    "next": "^14.2.29",
    "node-cron": "^4.2.1",
    "openai": "^6.39.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "postgres": "^3.4.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.51.0",
    "eslint-config-next": "^14.2.29",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7"
  }
}
